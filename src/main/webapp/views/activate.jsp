<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Kích hoạt</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="card shadow-sm p-4 mx-auto mt-5" style="max-width:420px"><h3>Kích hoạt tài khoản</h3><p>Nhập OTP đã gửi vào email.</p><form method="post"><input type="hidden" name="username" value="${param.username}"><input class="form-control mb-3" name="otp" maxlength="6" required placeholder="OTP 6 số"><button class="btn btn-primary w-100">Kích hoạt</button></form><c:if test="${not empty alert}"><div class="alert alert-danger mt-3">${alert}</div></c:if></main></body></html>