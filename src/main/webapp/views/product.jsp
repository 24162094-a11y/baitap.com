<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Sản phẩm</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><main class="container py-4"><h1 class="h3 mb-4">Tất cả sản phẩm</h1><div class="row g-4"><c:forEach items="${products}" var="product"><div class="col-sm-6 col-lg-4"><a class="card h-100 text-decoration-none" href="${pageContext.request.contextPath}/product/detail?id=${product.id}"><c:if test="${not empty product.image}"><img src="${pageContext.request.contextPath}/image?fname=${product.image}" class="card-img-top" style="height:210px;object-fit:cover"></c:if><div class="card-body"><h2 class="h5 text-dark">${product.name}</h2><p class="text-primary">${product.price} đ</p></div></a></div></c:forEach></div><nav class="mt-4"><c:forEach begin="1" end="${totalPages}" var="number"><a class="btn btn-sm ${number == page ? 'btn-primary' : 'btn-outline-primary'} me-1" href="?page=${number}">${number}</a></c:forEach></nav></main></body></html>