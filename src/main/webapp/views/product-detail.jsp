<%@ page contentType="text/html; charset=UTF-8" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>${product.name}</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body><main class="container py-5"><a href="${pageContext.request.contextPath}/category">← Danh mục</a><div class="row mt-4 g-5"><div class="col-md-6"><img src="${pageContext.request.contextPath}/image?fname=${product.image}" class="img-fluid rounded" alt="${product.name}"></div><div class="col-md-6"><h1>${product.name}</h1><p class="text-primary fs-4">${product.price} đ</p><p>${product.description}</p><p>Danh mục: ${product.category.name}</p></div></div></main></body></html>